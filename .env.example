# API Gateway (orquestador). Por acá pasa todo el front: leads, clientes,
# calificaciones, vehiculos y auth (login/refresh/logout).
VITE_API_URL=http://localhost:8080/api

# Solo para el Health Dashboard (/monitor): el servicio monitor y el sondeo
# directo de respaldo. El resto del front ya no llama directo a los servicios.
VITE_VEHICULOS_API_URL=http://localhost:8083
VITE_LEADS_API_URL=http://localhost:8000
VITE_CALIFICACION_API_URL=http://localhost:8084
VITE_CLIENTES_API_URL=http://localhost:8082
VITE_MONITOR_API_URL=http://localhost:8085
